; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PokeMT"
run/main_scene="uid://b06vsf41gn8xj"
config/features=PackedStringArray("4.5", "Mobile")
boot_splash/bg_color=Color(0.6716977, 0.6716976, 0.6716976, 1)
boot_splash/image="uid://81rfvepm121o"
config/icon="res://icon.svg"
boot_splash/minimum_display_time=250

[autoload]

Enums="*res://Enumerations/Enums.gd"
Traits="*res://Enumerations/Traits.gd"
Skills="*res://Enumerations/Skills.gd"
Demons="*res://Enumerations/Demons.gd"
Balance="*res://Enumerations/Balance.gd"
AuxFunc="*res://HelperFunctions/AuxiliaryFunctions.gd"
SaveLoad="*res://HelperFunctions/SaveLoad.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-sqlite/plugin.cfg")

[global_group]

Persist=""

[input]

ui_cancel={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194305,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, null]
}

[rendering]

